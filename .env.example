GEMINI_API_KEY=your_gemini_key_here

# Optional - enables the Adzuna job source (RemoteOK works with no key)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Login credentials for the web UI (defaults: demo@resume.ai / resume123)
APP_USERNAME=demo@resume.ai
APP_PASSWORD=resume123
# Set to 1 to show the demo credentials on the login page
APP_DEMO_HINT=0
